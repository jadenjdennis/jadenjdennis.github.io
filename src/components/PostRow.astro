---
import { categoryFor, formatDate, isoDate, readingMinutes, type Post } from '../lib/content';
import { withBase } from '../lib/url';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, date, category, kind, placeholder } = post.data;
const cat = categoryFor(category);
const minutes = readingMinutes(post.body);
---

<li class="post">
  <time class="post__date label tabular" datetime={isoDate(date)}>{formatDate(date)}</time>
  <div class="post__main">
    <h3><a class="post__link" href={withBase(`/blog/${post.id}/`)}>{title}</a></h3>
    <p class="post__desc">{description}</p>
    <p class="post__meta">
      <span>{cat.title}</span>
      <span>{kind === 'essay' ? 'Essay' : 'Note'}</span>
      <span class="tabular">{minutes} min read</span>
      {placeholder && <span class="post__flag">Placeholder, hidden in production</span>}
    </p>
  </div>
</li>

<style>
  .post {
    position: relative;
    display: grid;
    gap: 0.4rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .post:last-child {
    border-bottom: 1px solid var(--line);
  }
  .post__date {
    padding-top: 0.5rem;
  }
  .post h3 {
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.8rem);
  }
  .post__link {
    text-decoration: none;
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .post__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post:hover .post__link {
    color: var(--accent);
  }
  .post:has(.post__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .post__link:focus-visible {
    outline: none;
  }
  .post__desc {
    margin-top: 0.4rem;
    max-width: 56ch;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.7rem;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
  .post__meta span + span::before {
    content: '/';
    margin-right: 1rem;
    color: var(--line-strong);
  }
  .post__flag {
    color: var(--accent);
  }
  @media (min-width: 40rem) {
    .post {
      grid-template-columns: 7.5rem minmax(0, 1fr);
    }
  }
</style>
