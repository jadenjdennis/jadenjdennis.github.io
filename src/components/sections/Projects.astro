---
import Section from '../Section.astro';
import ProjectRow from '../ProjectRow.astro';
import ArrowIcon from '../ArrowIcon.astro';
import type { Project } from '../../lib/content';
import { withBase } from '../../lib/url';
import { getRepos } from '../../data/repos';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const repos = await getRepos();
---

<Section id="projects" title="Projects" hint="Work, as it exists." >
  <ul class="repos">
    {
      repos.map((r) => (
        <li class="repo">
          <a class="repo__link" href={r.href} target="_blank" rel="noopener noreferrer">
            <span class="repo__top">
              <h3 class="repo__name">{r.name}</h3>
              <span class="repo__arrow"><ArrowIcon /></span>
            </span>
            {r.description && <span class="repo__desc">{r.description}</span>}
            <span class="repo__meta">{r.language && <span class="repo__pill">{r.language}</span>}<span class="repo__pill">GitHub</span></span>
          </a>
        </li>
      ))
    }
  </ul>
  {
    projects.length > 0 && (
      <div class="stack stack--more">
        <ul>{projects.map((p) => <ProjectRow project={p} />)}</ul>
        <a class="arrow-link" href={withBase('/projects/')}>
          All projects <ArrowIcon />
        </a>
      </div>
    )
  }
</Section>

<style>
  .repos {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .repo {
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: var(--bg-raised);
    transition: transform 0.4s var(--ease-out), border-color 0.2s ease;
  }
  .repo:hover,
  .repo:focus-within {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .repo__link {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    text-decoration: none;
    color: inherit;
    border-radius: inherit;
  }
  .repo__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .repo__name {
    font-size: var(--text-h3);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .repo__arrow {
    color: var(--ink-muted);
    transition: transform 0.4s var(--ease-out), color 0.2s ease;
  }
  .repo:hover .repo__arrow {
    color: var(--accent);
    transform: translateX(0.35rem);
  }
  .repo__desc {
    color: var(--ink-body);
    max-width: 56ch;
  }
  .repo__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .repo__pill {
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--accent-fill);
    color: var(--on-accent-fill);
  }
  .repo__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .stack {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }
  .stack ul {
    width: 100%;
  }
  .empty {
    display: grid;
    gap: 1.25rem;
    max-width: 52ch;
  }
  .empty__body {
    color: var(--ink-body);
  }
  /* A quiet outline of the row a real project will occupy */
  .ghost {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1.5rem;
    margin-top: 1rem;
    padding-block: 1.25rem;
    border-block: 1px dashed var(--line-strong);
    color: var(--ink-muted);
  }
  .ghost__title {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    line-height: 1.15;
  }
  .ghost__summary {
    grid-column: 1;
    font-size: var(--text-sm);
  }
  .ghost__status {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
  }
</style>
