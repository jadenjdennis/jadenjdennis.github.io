---
import Photo from '../Photo.astro';
import { site } from '../../config/site';

const letters = [...site.name];
// Name the person in the caption only once a real portrait exists; a placeholder must not imply it depicts him.
const hasPortrait = Object.keys(import.meta.glob('/src/assets/photos/portrait.{jpg,jpeg,png,webp,avif}')).length > 0;
---

<section id="home" class="hero" data-section="home" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <h1 id="hero-title" class="hero__name" aria-label={site.name}>
      {letters.map((ch, i) => <span class="ch" style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
    </h1>

    <figure class="hero__portrait">
      <span class="hero__marks" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <Photo
        src="photos/portrait"
        ratio="4 / 5"
        label="Portrait"
        alt={`Portrait of ${site.fullName}`}
        recommended="1600 × 2000 px"
        sizes="(min-width: 44rem) 30vw, 70vw"
        loading="eager"
      />
      <figcaption class="hero__caption">{hasPortrait ? site.fullName : 'Portrait to come'}</figcaption>
    </figure>

    <div class="hero__intro">
      <p class="lead">
        A student at GSMST driven by a fascination with how humans interact with technology. My interested lie at the intersection of Human Centered Intelligence, wearable tech, and consumer psychology—understanding the "why" behind human behavior to build better tools for the future.

        What started with Legos as a kid has evolved into designing Vex V5 robots, leading technical teams, and growing my public speaking skills. On a journey to explore the talents God has given me!
      </p>
      <p class="hero__aside">An honest, evolving journey, and still being written.</p>
    </div>

    <p class="hero__cue">
      <span class="hero__cue-line" aria-hidden="true"></span>
      Keep scrolling, or open the Index above.
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.75rem, 4vh, 3.5rem) clamp(2.5rem, 6vh, 4.5rem);
  }
  .hero__grid {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero__name {
    font-size: clamp(5.5rem, 29vw, 9.5rem);
    line-height: 0.86;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin-left: -0.04em; /* optical alignment of the J with the grid */
  }
  .ch {
    display: inline-block;
  }

  .hero__portrait {
    position: relative;
    isolation: isolate;
    margin: 0;
    width: min(72%, 22rem);
    margin-left: auto;
    margin-right: 0.6rem; /* room for the crop marks that sit outside the frame */
  }
  /* Crop marks: four hairline corners just outside the frame, like a plate set for printing. */
  .hero__marks {
    position: absolute;
    inset: -0.6rem;
    pointer-events: none;
  }
  .hero__marks i {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border: 0 solid var(--accent);
  }
  .hero__marks i:nth-child(1) { top: 0; left: 0; border-width: 1.5px 0 0 1.5px; }
  .hero__marks i:nth-child(2) { top: 0; right: 0; border-width: 1.5px 1.5px 0 0; }
  .hero__marks i:nth-child(3) { bottom: 0; left: 0; border-width: 0 0 1.5px 1.5px; }
  .hero__marks i:nth-child(4) { bottom: 0; right: 0; border-width: 0 1.5px 1.5px 0; }
  .hero__caption {
    margin-top: 1.1rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .hero__intro {
    display: grid;
    gap: 1.25rem;
    max-width: 36ch;
  }
  .hero__aside {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    max-width: 38ch;
  }

  .hero__cue {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
  .hero__cue-line {
    width: 3rem;
    height: 1px;
    background: var(--line-strong);
  }

  @media (min-width: 44rem) {
    .hero {
      min-height: calc(100svh - var(--header-h));
      display: flex;
      padding-block: clamp(2rem, 6vh, 4.5rem) clamp(1.5rem, 4vh, 3rem);
    }
    .hero__grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto;
      column-gap: var(--col-gap);
      row-gap: 0;
    }
    .hero__name {
      grid-column: 1 / 9;
      grid-row: 1;
      font-size: clamp(8rem, 17vw, 15rem);
      align-self: start;
    }
    .hero__portrait {
      grid-column: 9 / 13;
      grid-row: 1 / 3;
      width: 100%;
      margin: clamp(3rem, 8vw, 7rem) 0 0;
      align-self: start;
    }
    .hero__marks {
      inset: -0.9rem;
    }
    .hero__portrait {
      margin-right: 0.9rem;
      width: calc(100% - 0.9rem);
    }
    .hero__intro {
      grid-column: 2 / 7;
      grid-row: 2;
      align-self: start;
      padding-top: clamp(2rem, 6vh, 4.5rem);
    }
    .hero__cue {
      grid-column: 1 / 9;
      grid-row: 3;
      margin-top: clamp(1.25rem, 4vh, 3rem);
    }
  }

  /* One authored moment: the name rises letter by letter, then the portrait and intro settle in. */
  @media (prefers-reduced-motion: no-preference) {
    .ch {
      animation: rise 1s var(--ease-out) both;
      animation-delay: calc(var(--i) * 80ms + 100ms);
    }
    .hero__marks {
      animation: fade-in 0.9s ease 0.5s both;
    }
    .hero__portrait :global(.photo) {
      animation: fade-in 0.9s ease 0.75s both;
    }
    .hero__intro,
    .hero__caption,
    .hero__cue {
      animation: fade-up 0.9s var(--ease-out) 0.85s both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.28em);
      filter: blur(10px);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
</style>
