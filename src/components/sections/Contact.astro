---
import Section from '../Section.astro';
import ArrowIcon from '../ArrowIcon.astro';
import { site } from '../../config/site';

const { github, linkedin, email } = site.contact;
---

<Section id="contact" title="Contact" hint="Say hello." class="section--field">
  <div class="contact">
    <p class="lead">If something here made you curious, I’d like to hear about it.</p>

    <ul class="contact__list">
      <li>
        <a href={github.href} rel="me noopener">
          <span class="contact__label">{github.label}</span>
          <span class="contact__value">{github.handle}</span>
          <ArrowIcon dir="up-right" size={22} />
        </a>
      </li>
      <li>
        <a href={linkedin.href} rel="me noopener">
          <span class="contact__label">{linkedin.label}</span>
          <span class="contact__value">{linkedin.handle}</span>
          <ArrowIcon dir="up-right" size={22} />
        </a>
      </li>
      <li data-email data-user={email.user} data-domain={email.domain}>
        <button type="button" class="contact__reveal" data-email-reveal>
          <span class="contact__label">{email.label}</span>
          <span class="contact__value">Show address</span>
          <ArrowIcon size={22} />
        </button>
        <noscript>
          <span class="contact__static">
            <span class="contact__label">{email.label}</span>
            <span class="contact__value">{email.user} [at] {email.domain.replace('.', ' [dot] ')}</span>
          </span>
        </noscript>
      </li>
    </ul>

    <p class="contact__note">I keep my email hidden to cut down on spam. Select it to show the address.</p>
  </div>
</Section>

<style is:global>
  .section--field {
    background: var(--field);
    color: var(--on-field);
    border-top: 0;
  }
  .section--field h2,
  .section--field .lead {
    color: var(--on-field);
  }
  .section--field .section__head p {
    color: var(--on-field);
    opacity: 0.88;
  }
  .section--field ::selection {
    background: var(--paper);
    color: var(--jade);
  }
  .section--field :focus-visible {
    outline-color: var(--on-field);
  }
</style>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .contact__list {
    border-bottom: 1px solid color-mix(in srgb, var(--on-field) 40%, transparent);
  }
  .contact__list li {
    border-top: 1px solid color-mix(in srgb, var(--on-field) 40%, transparent);
  }
  .contact__list a,
  .contact__reveal,
  .contact__static {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
    padding: 1.1rem 0;
    text-align: left;
    text-decoration: none;
    color: var(--on-field);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .contact__static {
    cursor: default;
  }
  .contact__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .contact__value {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.1rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
    transition: transform 0.4s var(--ease-out);
  }
  .contact__list a :global(svg),
  .contact__reveal :global(svg) {
    align-self: center;
    transition: transform 0.4s var(--ease-out);
  }
  .contact__list a:hover,
  .contact__reveal:hover {
    color: var(--on-field);
  }
  .contact__list a:hover .contact__value,
  .contact__reveal:hover .contact__value {
    transform: translateX(0.5rem);
  }
  .contact__list a:hover :global(svg),
  .contact__reveal:hover :global(svg) {
    transform: translate(0.25rem, -0.25rem);
  }
  .contact__note {
    max-width: 48ch;
    font-size: var(--text-sm);
    opacity: 0.9;
  }
  @media (max-width: 30rem) {
    .contact__list a,
    .contact__reveal,
    .contact__static {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .contact__label {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // Assemble the address only when asked: it never appears in the HTML source.
  const row = document.querySelector<HTMLElement>('[data-email]');
  const btn = row?.querySelector<HTMLButtonElement>('[data-email-reveal]');
  btn?.addEventListener('click', () => {
    if (!row) return;
    const address = `${row.dataset.user}@${row.dataset.domain}`;
    const link = document.createElement('a');
    link.href = `mailto:${address}`;
    // Carry over Astro's scoped-style attribute so the new link is styled like its siblings.
    for (const attr of btn.attributes) {
      if (attr.name.startsWith('data-astro-cid')) link.setAttribute(attr.name, attr.value);
    }
    link.innerHTML = btn.innerHTML;
    link.querySelector('.contact__value')!.textContent = address;
    btn.replaceWith(link);
    link.focus();
  });
</script>
