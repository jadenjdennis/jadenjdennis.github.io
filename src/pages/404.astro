---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---

<Base title="Page not found" noindex path="/404/">
  <section class="wrap lost">
    <h1>That page isn’t here.</h1>
    <p>It may have moved, or it may not exist yet. This site is still being written.</p>
    <p><a class="arrow-link" href={withBase('/')}>Back to the start</a></p>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(4rem, 3rem + 8vw, 9rem);
    min-height: 60svh;
    align-content: start;
    max-width: 40rem;
    margin-left: var(--gutter);
  }
</style>
